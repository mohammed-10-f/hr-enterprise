{
  "name": "hr-enterprise-saas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply hr-enterprise --local",
    "db:migrate:remote": "wrangler d1 migrations apply hr-enterprise --remote",
    "db:reset": "wrangler d1 migrations apply hr-enterprise --local --persist-to .wrangler/state"
  },
  "devDependencies": {
    "wrangler": "^4.39.0"
  }
}